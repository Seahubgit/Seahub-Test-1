<?php


declare(strict_types=1);

use Drupal\Core\Entity\Query\QueryInterface;
use Drupal\seahub_work_orders\WorkOrderStorage;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;

/**
 * Implements hook_entity_query_alter().
 *
 * Exclude soft-deleted Work Orders by default (deleted_at IS NULL),
 * unless the query is explicitly tagged to include deleted items.
 */
function seahub_work_orders_entity_query_alter(QueryInterface $query): void {
  // Only affect Work Order queries.
  if ($query->getEntityTypeId() !== 'work_order') {
    return;
  }

  // If the query is tagged to include deleted items, do not alter it.
  if ($query->hasTag(WorkOrderStorage::TAG_INCLUDE_DELETED)) {
    return;
  }

  // By default, exclude soft-deleted items.
  // deleted_at IS NULL
  $query->notExists('deleted_at');
}

/**
 * Implements hook_views_query_alter().
 *
 * Add the "include deleted" tag for the admin view that should show
 * soft-deleted Work Orders.
 */
function seahub_work_orders_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  // If this is the "all_work_order" view, include deleted items.
  if ($view->id() === 'all_work_order') {
    $query->addTag(WorkOrderStorage::TAG_INCLUDE_DELETED);
  }
}
